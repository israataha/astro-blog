---
import PageLayout from "@/layouts/PageLayout.astro";
import TopLayout from "@/layouts/TopLayout.astro";
import BottomLayout from "@/layouts/BottomLayout.astro";
import { NEWSLETTER } from "@/consts";
import { getNewsletterIssues } from "@/lib/buttondown";
import { formatDate } from "@/lib/utils";

const issues = await getNewsletterIssues();
---

<PageLayout title={NEWSLETTER.TITLE} description={NEWSLETTER.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {NEWSLETTER.TITLE}
    </div>
  </TopLayout>

  <div class="max-w-2xl mx-auto px-4 py-8">
    <div class="animate max-w-full">
      <div class="bg-black/5 dark:bg-white/10 rounded-lg p-6 border border-black/10 dark:border-white/20">
        <h2 class="text-xl font-semibold mb-2 text-black dark:text-white">
          Subscribe to the Open Tabs Newsletter
        </h2>
        <p class="mb-6 text-black/75 dark:text-white/75">
          A newsletter exploring the ideas, people, and conversations shaping tech and community delivered straight to
          your inbox.
        </p>
        <form
          action="https://buttondown.com/api/emails/embed-subscribe/opentabs"
          method="post"
          target="popupwindow"
          onsubmit="window.open('https://buttondown.com/opentabs', 'popupwindow')"
          class="space-y-4 embeddable-buttondown-form"
        >
          <div>
            <input
              type="email"
              id="bd-email"
              name="email"
              required
              placeholder="your.email@example.com"
              class="w-full px-3 py-2 rounded outline-none text-black dark:text-white bg-page/50 border border-black/20 dark:border-white/20 focus:border-black focus:dark:border-white transition-colors"
            />
          </div>
          <button type="submit" class="px-4 py-2 btn-accent font-medium rounded transition-colors blend">
            Subscribe
          </button>
        </form>
        <p class="text-xs text-black/60 dark:text-white/60 mt-3">
          No spam, unsubscribe at any time. Your email is safe with us.
        </p>
      </div>

      {
        issues.length > 0 && (
          <section class="mt-12">
            <div class="mb-6">
              <h2 class="text-2xl font-semibold text-black dark:text-white">Past issues</h2>
              <p class="text-sm text-black/60 dark:text-white/60 mt-1">Want to see what you've been missing?</p>
            </div>

            <ul class="space-y-3">
              {issues.map((issue) => (
                <li>
                  <a
                    href={issue.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-[var(--color-accent-soft)] border-[var(--color-border)] transition-colors duration-300 ease-in-out bg-surface"
                  >
                    <div class="w-full group-hover:text-ink blend">
                      <div class="text-sm uppercase text-muted">{formatDate(issue.date)}</div>
                      <div class="font-semibold mt-2 text-ink">{issue.title}</div>
                      {issue.summary && <div class="text-sm line-clamp-2 text-muted mt-1">{issue.summary}</div>}
                    </div>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="stroke-current shrink-0 group-hover:stroke-accent"
                    >
                      <line
                        x1="5"
                        y1="12"
                        x2="19"
                        y2="12"
                        class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
                      />
                      <polyline
                        points="12 5 19 12 12 19"
                        class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
                      />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>

  <BottomLayout />
</PageLayout>
