---
import PageLayout from "@/layouts/PageLayout.astro";
import TopLayout from "@/layouts/TopLayout.astro";
import BottomLayout from "@/layouts/BottomLayout.astro";
import MessageKeyboard from "@/components/MessageKeyboard";
import { CONTACT } from "@/consts";
import "@/styles/message-keyboard.css";
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {CONTACT.TITLE}
    </div>
  </TopLayout>

  <BottomLayout>
    <div class="animate pb-10">
      <p class="text-muted max-w-2xl">
        Got something to say? Mash the keys — yes, the clicky ones — and hit send. Drop your email if you want a reply back.
      </p>

      {/*
        Netlify Forms: after the first deploy that includes this form,
        open Netlify → Site → Forms → keyboard-message → Form notifications
        and set the destination to your inbox (e.g. israataha@gmail.com).
      */}
      <form name="keyboard-message" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
        <input name="bot-field" />
        <input type="email" name="email" />
        <textarea name="message"></textarea>
      </form>

      <MessageKeyboard client:load />
    </div>
  </BottomLayout>
</PageLayout>
