---
import { Image } from "astro:assets";
import heroImage from "@/assets/images/hero_image.jpg";
---

<!-- HERO — Monica-inspired denim layout; same copy as before -->
<section class="relative w-full">
  <div class="mx-auto max-w-screen-md px-5 py-6 md:py-8 mt-16 md:mt-20">
    <div class="hero-row animate relative z-10 flex flex-wrap items-center gap-5 md:gap-7">
      <Image
        src={heroImage}
        alt="Israa Taha"
        class="hero-avatar relative z-10 size-[140px] md:size-[180px] rounded-full object-cover object-[center_18%] shadow-[0_0_0_3px_var(--color-accent-soft)]"
        loading="eager"
        widths={[180, 360]}
        sizes="180px"
      />
      <div class="hero-identity min-w-0 flex-1">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-ink)] tracking-tight">
          <span class="hero-name">👋 Hi, I'm Israa</span>
        </h1>
        <p class="mt-2 text-lg md:text-xl text-[var(--color-accent)]">
          Mobile developer · <mark class="mark-accent">Speaker</mark> · Writer
        </p>
      </div>
    </div>

    <div class="hero-note animate relative z-0">
      <p class="hero-note-text text-[var(--color-ink)]/80 leading-relaxed m-0">
        I build cross-platform apps with React Native and Expo, focusing on architecture and quality. I care about the
        details that turn good software into great experiences — and I write and speak about what I learn along the way,
        from mobile patterns to how AI tools are changing the way we build and ship software.
      </p>
    </div>

    <div id="ctaButtons" class="animate flex flex-wrap gap-3 mt-5">
      <a
        href="/about"
        class="btn-accent inline-flex py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base blend"
      >
        Learn more
      </a>
      <a
        href="/contact"
        class="btn-accent-outline inline-flex py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base blend"
      >
        Say hi
      </a>
    </div>
  </div>
</section>

<style>
  .hero-name {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  .hero-note {
    margin-top: -2.25rem;
    padding: 2.75em 1.5em 1.5em;
    border-radius: 5px;
    background-color: var(--color-note);
    opacity: 0.95;
    box-shadow:
      rgba(0, 0, 0, 0.18) 0 1px 4px,
      rgba(0, 0, 0, 0.04) 0 0 40px inset;
  }

  .hero-note-text {
    font-size: 1.1rem;
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    .hero-note {
      margin-top: -3rem;
      padding: 3.25em 1.85em 1.75em;
    }

    .hero-note-text {
      font-size: 1.2rem;
    }
  }

  html.dark .hero-note {
    box-shadow:
      rgba(0, 0, 0, 0.35) 0 1px 4px,
      rgba(0, 0, 0, 0.08) 0 0 40px inset;
  }
</style>
